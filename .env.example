# Bitwarden CLI server (EU region)
BW_SERVER_URL=https://vault.bitwarden.eu

# Credentials: use ONE of the two paths. Values go in the Dockhand stack env
# (encrypted at rest) or in Vault, never in this file or in the repo.
# 1) personal API key + master password (the container logs in and unlocks)
BW_CLIENTID=
BW_CLIENTSECRET=
BW_PASSWORD=
# 2) an existing session key from `bw unlock --raw`
BW_TOKEN=
